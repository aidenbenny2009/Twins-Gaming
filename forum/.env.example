NODE_ENV=production
PORT=3000
# exactly the address people open, no trailing slash
PUBLIC_URL=https://your-forum.example.com
# 32+ random characters
SESSION_SECRET=
# PostgreSQL connection string (hosted ones need ?sslmode=require)
DATABASE_URL=
# optional
SMTP_URL=
GOOGLE_CLIENT_ID=
# first start only: creates the Owner account, then delete OWNER_PASSWORD
OWNER_USERNAME=
OWNER_EMAIL=
OWNER_PASSWORD=
# Google Search Console: the exact file name Google gives you, e.g. google1234abcd5678.html (leave empty if you verify another way)
GOOGLE_VERIFICATION_FILE=
